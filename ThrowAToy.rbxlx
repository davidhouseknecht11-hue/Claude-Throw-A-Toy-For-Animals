task.spawn(function()
	while true do
		task.wait(1)
		if Data then
			Data.ServerTime = (Data.ServerTime or 0) + 1
			luckTimer.Text = (Data.LuckyThrows or 0) > 0 and string.format("READY x%d", Data.LuckyThrows) or ""
