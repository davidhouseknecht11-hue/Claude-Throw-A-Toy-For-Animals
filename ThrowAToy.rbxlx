task.spawn(function()
	while true do
		task.wait(1)
		if Data then
			local left = (Data.LuckUntil or 0) - (Data.ServerTime or 0)
			Data.ServerTime = (Data.ServerTime or 0) + 1
			luckTimer.Text = left > 0 and ("ACTIVE " .. Util.Time(left)) or ""
