<Item class="ModuleScript" referent="RBX0000134A"><Properties>
<string name="Name">Config</string>
<ProtectedString name="Source"><![CDATA[-- Throw a Toy: all game tuning in one place. Shared by server and client.
local Config = {}

Config.Rarities = {
	{ Name = "Common", Color = Color3.fromRGB(205, 205, 215), Weight = 60, Mult = 1 },
	{ Name = "Uncommon", Color = Color3.fromRGB(85, 220, 95), Weight = 25, Mult = 2.5 },
	{ Name = "Rare", Color = Color3.fromRGB(70, 155, 255), Weight = 10, Mult = 6 },
	{ Name = "Epic", Color = Color3.fromRGB(180, 95, 255), Weight = 4, Mult = 15 },
	{ Name = "Legendary", Color = Color3.fromRGB(255, 190, 40), Weight = 0.9, Mult = 40 },
	{ Name = "Mythic", Color = Color3.fromRGB(255, 60, 125), Weight = 0.1, Mult = 120 },
	{ Name = "Exclusive", Color = Color3.fromRGB(0, 255, 210), Weight = 0, Mult = 300 }, -- Enchanted Egg only, never thrown
}

-- Enchanted Egg exclusives: earn like a Fantasy-zone pet x Exclusive rarity x Boost (a Void Kitsune out-earns ~100 Mythics).
Config.Exclusives = {
	{ Name = "Crystal Bunny", Chance = 35, Boost = 1 },
	{ Name = "Galaxy Cat", Chance = 30, Boost = 1.5 },
	{ Name = "Angel Pup", Chance = 20, Boost = 2.5 },
	{ Name = "Lava Tiger", Chance = 10, Boost = 4 },
	{ Name = "Rainbow Pegacorn", Chance = 4, Boost = 8 },
	{ Name = "Void Kitsune", Chance = 1, Boost = 20 },
}
Config.RarityIndex = {} :: { [string]: number }
for i, r in Config.Rarities do
	Config.RarityIndex[r.Name] = i
end

-- Zones run down the corridor in this order. Colors drive the generated map and the throw-camera lighting.
Config.Zones = {
	{ Name = "Backyard", Icon = "🏡", Floor = Color3.fromRGB(98, 206, 72), Wall = Color3.fromRGB(150, 98, 60), Top = Color3.fromRGB(120, 220, 80),
		Sky = Color3.fromRGB(150, 205, 255),
		Animals = { { "Dog", "Common" }, { "Cat", "Common" }, { "Bunny", "Uncommon" }, { "Hamster", "Rare" } } },
	{ Name = "Farm", Icon = "🌾", Floor = Color3.fromRGB(224, 196, 110), Wall = Color3.fromRGB(176, 64, 52), Top = Color3.fromRGB(240, 210, 90),
		Sky = Color3.fromRGB(255, 215, 160),
		Animals = { { "Pig", "Common" }, { "Duck", "Common" }, { "Cow", "Uncommon" }, { "Sheep", "Rare" } } },
	{ Name = "Jungle", Icon = "🌴", Floor = Color3.fromRGB(46, 150, 70), Wall = Color3.fromRGB(70, 92, 60), Top = Color3.fromRGB(40, 175, 80),
		Sky = Color3.fromRGB(150, 230, 170),
		Animals = { { "Monkey", "Common" }, { "Fox", "Uncommon" }, { "Gorilla", "Rare" }, { "Tiger", "Epic" } } },
	{ Name = "Safari", Icon = "🦁", Floor = Color3.fromRGB(232, 190, 110), Wall = Color3.fromRGB(196, 120, 64), Top = Color3.fromRGB(205, 180, 80),
		Sky = Color3.fromRGB(255, 190, 120),
		Animals = { { "Zebra", "Common" }, { "Giraffe", "Uncommon" }, { "Elephant", "Rare" }, { "Lion", "Epic" } } },
	{ Name = "Arctic", Icon = "❄️", Floor = Color3.fromRGB(236, 246, 255), Wall = Color3.fromRGB(140, 196, 240), Top = Color3.fromRGB(255, 255, 255),
		Sky = Color3.fromRGB(190, 230, 255),
		Animals = { { "Penguin", "Rare" }, { "Polar Bear", "Epic" }, { "Arctic Wolf", "Legendary" } } },
	{ Name = "Fantasy", Icon = "🐉", Floor = Color3.fromRGB(120, 80, 210), Wall = Color3.fromRGB(60, 40, 120), Top = Color3.fromRGB(255, 120, 230),
		Sky = Color3.fromRGB(220, 150, 255),
		Animals = { { "Phoenix", "Legendary" }, { "Dragon", "Mythic" }, { "Crystal Wolf", "Mythic" } } },
}

-- Map layout (studs). The generator in tools/build_place.py uses the same numbers.
Config.Map = {
	ThrowPad = Vector3.new(0, 0.5, -60),
	CorridorStartZ = -72, -- distance 0 is here
	ZoneLength = 230,
	CorridorHalfWidth = 34,
}

-- Toys are the "food": better toys = more luck. Price in cash.
Config.Toys = {
	{ Name = "Tennis Ball", Rarity = "Common", Price = 0, Luck = 1 },
	{ Name = "Squeaky Bone", Rarity = "Common", Price = 300, Luck = 1.3 },
	{ Name = "Rubber Duck", Rarity = "Uncommon", Price = 2500, Luck = 1.7 },
	{ Name = "Frisbee", Rarity = "Uncommon", Price = 25e3, Luck = 2.2 },
	{ Name = "Yarn Ball", Rarity = "Rare", Price = 300e3, Luck = 3 },
	{ Name = "Teddy Bear", Rarity = "Rare", Price = 4e6, Luck = 4 },
	{ Name = "Toy Rocket", Rarity = "Epic", Price = 60e6, Luck = 6 },
	{ Name = "Robot Toy", Rarity = "Legendary", Price = 1e9, Luck = 9 },
	{ Name = "Crystal Orb", Rarity = "Mythic", Price = 20e9, Luck = 15 },
}

-- Pull-up bar levels: power gained per rep.
Config.Bars = {
	{ Price = 0, PerRep = 1, Color = Color3.fromRGB(70, 90, 200) },
	{ Price = 500, PerRep = 3, Color = Color3.fromRGB(60, 190, 90) },
	{ Price = 6000, PerRep = 8, Color = Color3.fromRGB(240, 200, 40) },
	{ Price = 75e3, PerRep = 20, Color = Color3.fromRGB(255, 120, 40) },
	{ Price = 1e6, PerRep = 50, Color = Color3.fromRGB(230, 50, 60) },
	{ Price = 15e6, PerRep = 120, Color = Color3.fromRGB(190, 70, 255) },
	{ Price = 250e6, PerRep = 300, Color = Color3.fromRGB(60, 230, 255) },
	{ Price = 5e9, PerRep = 800, Color = Color3.fromRGB(255, 70, 200) },
}
Config.RepSeconds = 0.6

Config.Sizes = {
	{ Name = "Normal", Chance = 75, Mult = 1, Scale = 1 },
	{ Name = "Big", Chance = 18, Mult = 1.5, Scale = 1.3 },
	{ Name = "Large", Chance = 6, Mult = 2.5, Scale = 1.6 },
	{ Name = "Huge", Chance = 1, Mult = 5, Scale = 2.1 },
}
Config.Mutations = {
	{ Name = "None", Chance = 89.5, Mult = 1 },
	{ Name = "Golden", Chance = 7.5, Mult = 3, Color = Color3.fromRGB(255, 200, 40) },
	{ Name = "Rainbow", Chance = 2.5, Mult = 8, Color = Color3.fromRGB(255, 90, 200) },
	{ Name = "Cosmic", Chance = 0.5, Mult = 25, Color = Color3.fromRGB(90, 70, 255) },
}

Config.StartPower = 10
Config.StartSlots = 6
Config.MaxSlots = 30
Config.MaxAnimals = 120 -- plot + backpack; extra catches auto-sell
Config.SellSeconds = 60 -- an animal sells for this many seconds of its income
Config.IndexZoneBonus = 0.1 -- +10% income per fully discovered zone
Config.OfflineCapHours = 8
Config.OfflineRate = 0.5
Config.ThrowCooldown = 1.5 -- seconds after the reveal finishes
Config.RevealSeconds = 5.5 -- animal walks in, name reveal, result card
Config.OneInMin = 100 -- pulls rarer than 1 in this get the "1 in X" reveal
Config.OneInSeconds = 2.4 -- how much longer that reveal runs

function Config.FlightTime(distance: number): number
	return 1.4 + distance / 230
end

-- Monetization. Set these after creating the products on the Creator Dashboard (0 = hidden).
Config.LuckProductId = 0 -- developer product: 100x luck for 15 minutes
Config.LuckBoost = 100
Config.LuckBoostSeconds = 15 * 60

-- Robux shop (layout from the Figma "Roblox shop" frame). Id = developer product / game pass id from the Creator
-- Dashboard; 0 = button says "not for sale yet". Robux is display only: keep it equal to the dashboard price.
Config.Shop = {
	Eggs = {
		{ Name = "ENCHANTED EGG", Badge = "NEW!", Blurb = "A little magic. A legendary new friend.", Icon = "Icon Egg Enchanted",
			Pool = {}, -- filled from Config.Exclusives below
			Buy = { { Key = "Enchanted1", Count = 1, Robux = 72, Id = 0 }, { Key = "Enchanted3", Count = 3, Robux = 180, Id = 0 },
				{ Key = "Enchanted10", Count = 10, Robux = 585, Id = 0 } } },
		{ Name = "RAINBOW EGG", Badge = "LIMITED", Blurb = "Hatch a random Rainbow Huge animal!", Icon = "Icon Egg Rainbow",
			Mutation = "Rainbow", Size = "Huge", -- pool: every animal, weighted by rarity
			Buy = { { Key = "Rainbow1", Count = 1, Robux = 90, Id = 0 }, { Key = "Rainbow3", Count = 3, Robux = 225, Id = 0 } } },
	},
	-- packs grow as you get richer: the bigger of Seconds of income or Share of the cash you hold (see CashPackValue)
	CashPacks = {
		{ Key = "Cash1", Seconds = 600, Share = 0.25, Robux = 22, Id = 0 },
		{ Key = "Cash2", Seconds = 3600, Share = 1, Robux = 54, Id = 0, Tag = "GOOD VALUE" },
		{ Key = "Cash3", Seconds = 6 * 3600, Share = 3, Robux = 72, Id = 0, Tag = "GREAT VALUE" },
		{ Key = "Cash4", Seconds = 24 * 3600, Share = 10, Robux = 180, Id = 0, Tag = "BEST VALUE" },
	},
	MinIncome = 20,
	Passes = { -- game passes
		{ Key = "CashPass", Name = "x2 CASH", Text = "Double cash from every animal!", Icon = "Icon Cash", Robux = 90, Id = 0 },
		{ Key = "TrainPass", Name = "x2 TRAINING POWER", Text = "Double power on every pull-up!", Icon = "Icon Muscle", Robux = 135, Id = 0 },
	},
}
for _, e in Config.Exclusives do
	table.insert(Config.Shop.Eggs[1].Pool, { e.Name, e.Chance })
end

function Config.CashPackValue(pack, income: number, cash: number): number
	return math.floor(math.max(math.max(income, Config.Shop.MinIncome) * pack.Seconds, cash * pack.Share))
end
assert(Config.CashPackValue(Config.Shop.CashPacks[4], 0, 1e6) == 10e6 and Config.CashPackValue(Config.Shop.CashPacks[1], 0, 0) == 12000,
	"CashPackValue self-check failed")

Config.ShopItem = {} :: { [string]: any } -- Key -> entry (egg buys also get .Egg)
for _, egg in Config.Shop.Eggs do
	for _, b in egg.Buy do
		b.Egg = egg
		Config.ShopItem[b.Key] = b
	end
end
for _, list in { Config.Shop.CashPacks, Config.Shop.Passes } do
	for _, it in list do
		Config.ShopItem[it.Key] = it
	end
end

function Config.SlotPrice(slots: number): number
	return math.floor(150 * 3 ^ ((slots - Config.StartSlots) / 2))
end

function Config.ThrowDistance(power: number, quality: number): number
	return (25 + 15 * power ^ 0.4) * (0.35 + 0.65 * math.clamp(quality, 0, 1))
end

-- Every throw trains power; better meter timing trains more (like the original). Highest Min first.
Config.Ratings = {
	{ Name = "PERFECT!", Min = 0.92, Color = Color3.fromRGB(80, 230, 90) },
	{ Name = "GOOD", Min = 0.65, Color = Color3.fromRGB(190, 240, 70) },
	{ Name = "OK", Min = 0.35, Color = Color3.fromRGB(255, 190, 50) },
	{ Name = "BAD", Min = 0, Color = Color3.fromRGB(240, 60, 60) },
}

-- Gain climbs smoothly with the marker (squared, so the top is worth far more): +1..+5 for a new player,
-- ~+24 at the top for 2K power. The flat 5 keeps the number moving even at low power.
function Config.ThrowRating(quality: number, power: number): (any, number)
	local gain = math.max(1, math.floor(quality ^ 2 * (5 + power * 0.0095) + 0.5))
	for _, r in Config.Ratings do
		if quality >= r.Min then
			return r, gain
		end
	end
	return Config.Ratings[#Config.Ratings], gain
end
assert(Config.ThrowRating(1, 2000).Name == "PERFECT!" and select(2, Config.ThrowRating(0.7, 2000)) == 12
	and select(2, Config.ThrowRating(1, 10)) == 5 and select(2, Config.ThrowRating(0, 10)) == 1, "ThrowRating self-check failed")

function Config.ZoneAt(distance: number): number
	return math.clamp(math.floor(distance / Config.Map.ZoneLength) + 1, 1, #Config.Zones)
end

function Config.LuckAt(distance: number): number
	return 1 + distance / 40
end

function Config.BaseIncome(zoneIndex: number, rarity: string): number
	return 2 * 12 ^ (zoneIndex - 1) * Config.Rarities[Config.RarityIndex[rarity]].Mult
end

-- name -> {Zone = index, Rarity = name}
Config.AnimalInfo = {} :: { [string]: { Zone: number, Rarity: string, Boost: number? } }
for zi, z in Config.Zones do
	for _, a in z.Animals do
		Config.AnimalInfo[a[1]] = { Zone = zi, Rarity = a[2] }
	end
end
for _, e in Config.Exclusives do
	Config.AnimalInfo[e.Name] = { Zone = #Config.Zones, Rarity = "Exclusive", Boost = e.Boost }
end
Config.ToyInfo = {} :: { [string]: any }
for i, t in Config.Toys do
	Config.ToyInfo[t.Name] = t
	t.Index = i
end

function Config.Find(list: { any }, name: string): any
	for _, v in list do
		if v.Name == name then
			return v
		end
	end
	return nil
end

return Config
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000134B"><Properties>
<string name="Name">Util</string>
<ProtectedString name="Source"><![CDATA[-- Shared helpers: number formatting and weighted rolls.
local Util = {}

local SUFFIX = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

function Util.Format(n: number): string
	if n ~= n then
		return "0"
	end
	local neg = n < 0
	n = math.abs(n)
	local i = 1
	while n >= 1000 and i < #SUFFIX do
		n /= 1000
		i += 1
	end
	local s
	if i == 1 then
		s = tostring(math.floor(n))
	elseif n >= 100 then
		s = string.format("%d", math.floor(n)) .. SUFFIX[i]
	elseif n >= 10 then
		s = string.format("%.1f", math.floor(n * 10) / 10) .. SUFFIX[i]
	else
		s = string.format("%.2f", math.floor(n * 100) / 100) .. SUFFIX[i]
	end
	-- trim trailing decimal zeros only ("1.50K" -> "1.5K", "2.00M" -> "2M", "100K" untouched)
	s = s:gsub("(%.%d-)0+([A-Za-z]+)$", "%1%2")
	s = s:gsub("%.([A-Za-z]+)$", "%1")
	return (neg and "-" or "") .. s
end

-- items: array; weightOf(item) -> number. rng: Random.
-- Weighted pick; also returns the chance (0..1) of what was picked, for the "1 in X" reveal.
function Util.Pick<T>(items: { T }, weightOf: (T) -> number, rng: Random): (T, number)
	local total = 0
	for _, it in items do
		total += weightOf(it)
	end
	local r = rng:NextNumber() * total
	for _, it in items do
		local w = weightOf(it)
		r -= w
		if r <= 0 then
			return it, w / total
		end
	end
	return items[#items], weightOf(items[#items]) / total
end

function Util.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

return Util
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000134C"><Properties>
<string name="Name">ThrowAnim</string>
<ProtectedString name="Source"><![CDATA[-- Full-body overhand throw for R15 (R6 falls back to the shoulder only), authored as keyframes and played with
-- Catmull-Rom splines every frame so it moves like a hand-keyed animation without needing an uploaded asset.
-- Joints are posed through Motor6D.C0, or Attachment0.CFrame on upgraded (AnimationConstraint) avatars; both rotate
-- the child about the joint the same way. Values per joint: {pitch, yaw, roll, x, y, z} (degrees / studs, from rest).
-- +pitch swings a hanging limb forward and tips the torso back; +yaw turns the body to its left; +roll raises the right
-- arm out to the side (and, on an elbow, folds the forearm up); Root x/y/z move the hips (right / up / back).
-- The cocked arm is roll-driven (elbow out at shoulder height, forearm up) because pitching an R15 arm back folds it
-- in front of the face; verified on a Studio dummy.
local RunService = game:GetService("RunService")

local ThrowAnim = {}
ThrowAnim.Release = 0.62 -- seconds in: the toy leaves the hand
ThrowAnim.Length = 1.5

local KEYS = {
	{ t = 0.0, pose = {} },
	{ -- anticipation: small dip, weight rocks back, arm starts to lift, eyes lock on target
		t = 0.18, pose = {
			Root = { 0, -12, 0, 0, -0.15, 0.12 }, Waist = { 4, -10, 0 }, Neck = { 0, 18, 0 },
			RightShoulder = { 0, -8, 45 }, RightElbow = { 0, 0, 35 },
			LeftShoulder = { 25, 0, 0 }, LeftElbow = { 20, 0, 0 },
			RightHip = { 4, 0, 0 }, RightKnee = { -14, 0, 0 }, LeftHip = { 8, 0, 0 }, LeftKnee = { -12, 0, 0 },
		} },
	{ -- full coil: body loaded on the back leg, throwing arm cocked high behind the head, glove arm aims, front knee lifts
		t = 0.42, pose = {
			Root = { 0, -28, 0, 0, -0.28, 0.3 }, Waist = { 12, -28, 0 }, Neck = { -4, 50, 0 },
			RightShoulder = { 0, -28, 96 }, RightElbow = { 0, 0, 100 }, RightWrist = { -30, 0, 0 },
			LeftShoulder = { 88, -12, 0 }, LeftElbow = { 10, 0, 0 },
			RightHip = { -4, 0, 0 }, RightKnee = { -28, 0, 0 }, RightAnkle = { 10, 0, 0 },
			LeftHip = { 48, 0, 0 }, LeftKnee = { -58, 0, 0 }, LeftAnkle = { -15, 0, 0 },
		} },
	{ -- stride plant: front foot lands, hips start to open, arm still cocked (the "lag" that sells power)
		t = 0.53, pose = {
			Root = { 0, -10, 0, 0, -0.36, 0.05 }, Waist = { 8, -32, 0 }, Neck = { -2, 40, 0 },
			RightShoulder = { -10, -40, 100 }, RightElbow = { 0, 0, 115 }, RightWrist = { -40, 0, 0 },
			LeftShoulder = { 70, -8, 0 }, LeftElbow = { 25, 0, 0 },
			RightHip = { -18, 0, 0 }, RightKnee = { -35, 0, 0 }, RightAnkle = { 20, 0, 0 },
			LeftHip = { 34, 0, 0 }, LeftKnee = { -18, 0, 0 }, LeftAnkle = { -6, 0, 0 },
		} },
	{ -- release: hips and chest whip through, arm fires forward, wrist snaps, glove arm tucks, back leg drives
		t = 0.62, pose = {
			Root = { -6, 22, 0, 0, -0.34, -0.32 }, Waist = { -22, 34, 0 }, Neck = { 8, -30, 0 },
			RightShoulder = { 100, 0, 10 }, RightElbow = { 12, 0, 0 }, RightWrist = { 35, 0, 0 },
			LeftShoulder = { 18, 0, 0 }, LeftElbow = { 75, 0, 0 },
			RightHip = { -38, 0, 0 }, RightKnee = { -48, 0, 0 }, RightAnkle = { 35, 0, 0 },
			LeftHip = { 36, 0, 0 }, LeftKnee = { -24, 0, 0 }, LeftAnkle = { -4, 0, 0 },
		} },
	{ -- follow-through: chest over the front knee, arm finishes low across the body, back heel kicks up
		t = 0.8, pose = {
			Root = { -10, 32, 0, 0, -0.42, -0.45 }, Waist = { -30, 44, 0 }, Neck = { 12, -36, 0 },
			RightShoulder = { 52, 30, -34 }, RightElbow = { 42, 0, 0 }, RightWrist = { 20, 0, 0 },
			LeftShoulder = { -18, 0, 0 }, LeftElbow = { 85, 0, 0 },
			RightHip = { -46, 0, 0 }, RightKnee = { -78, 0, 0 }, RightAnkle = { 30, 0, 0 },
			LeftHip = { 40, 0, 0 }, LeftKnee = { -32, 0, 0 },
		} },
	{ -- recovery step: back leg swings through, body rises and squares up
		t = 1.08, pose = {
			Root = { -4, 12, 0, 0, -0.14, -0.2 }, Waist = { -8, 14, 0 }, Neck = { 4, -10, 0 },
			RightShoulder = { 20, 10, -10 }, RightElbow = { 30, 0, 0 },
			LeftShoulder = { 5, 0, 0 }, LeftElbow = { 35, 0, 0 },
			RightHip = { 14, 0, 0 }, RightKnee = { -22, 0, 0 }, LeftHip = { 10, 0, 0 }, LeftKnee = { -10, 0, 0 },
		} },
	{ t = 1.5, pose = {} }, -- settle to rest
}

local JOINTS = { "Root", "Waist", "Neck", "RightShoulder", "RightElbow", "RightWrist", "LeftShoulder", "LeftElbow",
	"RightHip", "RightKnee", "RightAnkle", "LeftHip", "LeftKnee", "LeftAnkle" }

local function value(key, joint: string, i: number): number
	local p = key.pose[joint]
	return p and p[i] or 0
end

-- Catmull-Rom through the keyframes; returns {pitch, yaw, roll, x, y, z} for a joint at time t
local function sample(joint: string, t: number): { number }
	t = math.clamp(t, 0, ThrowAnim.Length)
	local i = 1
	while i < #KEYS - 1 and KEYS[i + 1].t <= t do
		i += 1
	end
	local k0, k1, k2, k3 = KEYS[math.max(i - 1, 1)], KEYS[i], KEYS[i + 1], KEYS[math.min(i + 2, #KEYS)]
	local u = (t - k1.t) / (k2.t - k1.t)
	local u2, u3 = u * u, u * u * u
	local out = table.create(6, 0)
	for c = 1, 6 do
		local p0, p1, p2, p3 = value(k0, joint, c), value(k1, joint, c), value(k2, joint, c), value(k3, joint, c)
		out[c] = 0.5 * (2 * p1 + (-p0 + p2) * u + (2 * p0 - 5 * p1 + 4 * p2 - p3) * u2 + (-p0 + 3 * p1 - 3 * p2 + p3) * u3)
	end
	return out
end

type Rig = { [string]: { T: Instance, Prop: string, Base: CFrame } }

local function findJoint(char: Model, name: string): (Instance?, string?)
	local j = char:FindFirstChild(name, true)
	if j and j:IsA("Motor6D") then
		return j, "C0"
	elseif j and j:IsA("AnimationConstraint") and j.Attachment0 then
		return j.Attachment0, "CFrame"
	end
	return nil, nil
end

function ThrowAnim.Rig(char: Model): (Rig, boolean)
	local r15 = char:FindFirstChild("UpperTorso") ~= nil
	local rig = {}
	for _, name in JOINTS do
		local target, prop = findJoint(char, r15 and name or (name == "RightShoulder" and "Right Shoulder" or "\0"))
		if target then
			rig[name] = { T = target, Prop = prop, Base = (target :: any)[prop] }
		end
	end
	return rig, r15
end

-- Pose every rigged joint at time t (also used by the Studio preview to inspect single frames).
function ThrowAnim.Pose(rig: Rig, r15: boolean, t: number)
	for name, j in rig do
		local v = sample(name, t)
		local rot = r15 and CFrame.Angles(math.rad(v[1]), math.rad(v[2]), math.rad(v[3])) or CFrame.Angles(0, 0, math.rad(v[1]))
		local target: any = j.T -- (no line may start with "(" here: Luau would read it as a call)
		target[j.Prop] = j.Base * CFrame.new(v[4], v[5], v[6]) * rot
	end
end

function ThrowAnim.Restore(rig: Rig)
	for _, j in rig do
		local target: any = j.T
		if target.Parent then
			target[j.Prop] = j.Base
		end
	end
end

-- Play on a character; onRelease fires at the release frame. timeScale < 1 slows it (for previews).
function ThrowAnim.Play(char: Model, onRelease: (() -> ())?, timeScale: number?)
	local rig, r15 = ThrowAnim.Rig(char)
	local t, released = 0, false
	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		t += dt * (timeScale or 1)
		if not char.Parent or t >= ThrowAnim.Length then
			conn:Disconnect()
			ThrowAnim.Restore(rig)
			return
		end
		ThrowAnim.Pose(rig, r15, t)
		if not released and t >= ThrowAnim.Release then
			released = true
			if onRelease then
				task.spawn(onRelease)
			end
		end
	end)
end

-- self-check: the spline hits each authored key exactly and starts/ends at rest
assert(math.abs(sample("RightShoulder", 0.42)[3] - 96) < 1e-6 and sample("Waist", 0)[2] == 0 and sample("Waist", 1.5)[2] == 0,
	"ThrowAnim spline self-check failed")

return ThrowAnim
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000134D"><Properties>
<string name="Name">Mutations</string>
<ProtectedString name="Source"><![CDATA[-- Real mutations: the pet's own bricks are recolored (gold / rainbow / deep space) and a Blender-made prop is attached
-- (crown on the head, rainbow arc over the back, cosmic ring around the body). Used on plot pets (server) and on the
-- reveal / UI thumbnails (client) so a mutation looks the same everywhere.
local Models = game:GetService("ReplicatedStorage"):WaitForChild("Models")

local Mutations = {}

local GOLD_DARK, GOLD_LIGHT = Color3.fromRGB(150, 92, 8), Color3.fromRGB(255, 228, 100)
local SPACE_DARK, SPACE_LIGHT = Color3.fromRGB(14, 9, 44), Color3.fromRGB(120, 75, 255)
local STARLIGHT = Color3.fromRGB(160, 130, 255)
local PROP = { Golden = "Mut Crown", Rainbow = "Mut Rainbow", Cosmic = "Mut Ring" }

local function lum(c: Color3): number
	return c.R * 0.299 + c.G * 0.587 + c.B * 0.114
end

-- min/max corner of parts in `space` (object space of a CFrame)
local function bounds(parts: { BasePart }, space: CFrame): (Vector3, Vector3)
	local lo, hi = Vector3.one * math.huge, -Vector3.one * math.huge
	for _, p in parts do
		local h = p.Size / 2
		for _, s in { Vector3.new(1, 1, 1), Vector3.new(1, 1, -1), Vector3.new(1, -1, 1), Vector3.new(1, -1, -1),
			Vector3.new(-1, 1, 1), Vector3.new(-1, 1, -1), Vector3.new(-1, -1, 1), Vector3.new(-1, -1, -1) } do
			local v = space:PointToObjectSpace(p.CFrame:PointToWorldSpace(h * s))
			lo, hi = lo:Min(v), hi:Max(v)
		end
	end
	return lo, hi
end

local function bricks(model: Model): { BasePart }
	local out = {}
	for _, p in model:GetChildren() do
		if p:IsA("BasePart") and p ~= model.PrimaryPart then
			table.insert(out, p)
		end
	end
	return out
end

local function recolor(parts: { BasePart }, mutation: string, pivot: CFrame, lo: Vector3, span: Vector3)
	for _, p in parts do
		local l = lum(p.Color)
		if p.Material == Enum.Material.Neon or l < 0.12 then
			continue -- eyes, noses and glowing bits keep their look
		end
		if mutation == "Golden" then
			p.Color = GOLD_DARK:Lerp(GOLD_LIGHT, math.clamp((l - 0.12) / 0.8, 0, 1))
			p.Reflectance = 0.25
		elseif mutation == "Rainbow" then
			local rel = pivot:PointToObjectSpace(p.Position) - lo
			local hue = (rel.Z / math.max(span.Z, 0.1) * 0.8 + rel.Y / math.max(span.Y, 0.1) * 0.2) % 1
			local sat = 0.45 + 0.35 * (1 - l)
			p.Color = Color3.fromHSV(hue, sat, 1)
			p:SetAttribute("Hue", hue)
			p:SetAttribute("Sat", sat)
		elseif mutation == "Cosmic" then
			if l > 0.82 then
				p.Material = Enum.Material.Neon
				p.Color = STARLIGHT
			else
				p.Color = SPACE_DARK:Lerp(SPACE_LIGHT, l ^ 1.5)
			end
		end
	end
end

local function attachProp(model: Model, mutation: string, parts: { BasePart }, pivot: CFrame, lo: Vector3, hi: Vector3)
	local tpl = Models:FindFirstChild(PROP[mutation])
	if not tpl then
		return
	end
	local prop = tpl:Clone()
	local pparts = bricks(prop)
	local plo, phi = bounds(pparts, prop:GetPivot())
	local psize = phi - plo
	local span, mid = hi - lo, (lo + hi) / 2
	local bone, scale, place
	if mutation == "Golden" then -- crown sits on top of the head
		local head = {}
		for _, p in parts do
			if p.Name == "head" then
				table.insert(head, p)
			end
		end
		local hlo, hhi = bounds(#head > 0 and head or parts, pivot)
		local hmid = (hlo + hhi) / 2
		bone, scale = "head", (hhi.X - hlo.X) * 0.7 / psize.X
		place = pivot * CFrame.new(hmid.X, hhi.Y - 0.08 * scale, hmid.Z)
	elseif mutation == "Rainbow" then -- arc over the back, nose to tail
		bone, scale = "body", math.max(span.Z * 1.2 / psize.X, span.Y * 1.3 / psize.Y) -- clears the whole pet
		place = pivot * CFrame.new(mid.X, lo.Y, mid.Z) * CFrame.Angles(0, math.pi / 2, 0)
	else -- cosmic ring around the middle, tilted like a planet's
		bone, scale = "body", math.max(span.X, span.Z) * 1.35 / psize.X
		place = pivot * CFrame.new(mid.X, lo.Y + span.Y * 0.45 - psize.Y * scale / 2, mid.Z) * CFrame.Angles(math.rad(16), 0, math.rad(8))
	end
	prop:ScaleTo(math.max(scale, 0.05))
	prop:PivotTo(place * CFrame.new(0, -plo.Y * math.max(scale, 0.05), 0))
	for _, p in bricks(prop) do
		p.Name = bone -- the pet animator moves it with that bone (crown bobs with the head)
		p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
		p.Parent = model
	end
	prop:Destroy()
end

-- Apply once to a pet model that is already scaled and placed.
function Mutations.Apply(model: Model, mutation: string?)
	if not mutation or not PROP[mutation] or model:GetAttribute("Mutated") then
		return
	end
	model:SetAttribute("Mutated", mutation)
	local parts = bricks(model)
	local pivot = model:GetPivot()
	local lo, hi = bounds(parts, pivot)
	recolor(parts, mutation, pivot, lo, hi - lo)
	attachProp(model, mutation, parts, pivot, lo, hi)
end

-- Rainbow pets shimmer: returns the bricks to recolor each frame with Mutations.Shimmer.
function Mutations.RainbowParts(model: Model): { BasePart }
	local out = {}
	for _, p in model:GetChildren() do
		if p:IsA("BasePart") and p:GetAttribute("Hue") then
			table.insert(out, p)
		end
	end
	return out
end

function Mutations.Shimmer(parts: { BasePart }, t: number)
	for _, p in parts do
		p.Color = Color3.fromHSV(((p:GetAttribute("Hue") :: number) + t * 0.2) % 1, p:GetAttribute("Sat") :: number, 1)
	end
end

return Mutations
]]></ProtectedString>
</Properties>
</Item>
